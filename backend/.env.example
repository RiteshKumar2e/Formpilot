# Copy to .env and fill in. Never commit .env.

# "development" or "production". Production refuses to start with default secrets.
ENVIRONMENT=development

# Signs session tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encrypts uploaded files at rest (Fernet key).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# SQLite for local development; PostgreSQL in production, e.g.
# postgresql+psycopg://formpilot:password@localhost:5432/formpilot
DATABASE_URL=sqlite:///./formpilot.db

# Where encrypted uploads are stored.
STORAGE_DIR=./storage

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Redirect HTTP to HTTPS and send HSTS. Defaults to true when ENVIRONMENT=production.
# ENFORCE_HTTPS=true

# Behind a reverse proxy (Nginx, Render, Railway...), trust its X-Forwarded-* headers
# so HTTPS detection and per-IP rate limits see the real client.
TRUST_PROXY_HEADERS=false

# Per-IP limits on sign-up, sign-in, contact and uploads.
RATE_LIMIT_ENABLED=true
SESSION_HOURS=12
