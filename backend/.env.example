# Copy to .env and fill in. Never commit .env.

# "development" or "production". Production refuses to start with default secrets.
ENVIRONMENT=development

# Signs session tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encrypts uploaded files and personal data in the database (Fernet key).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# --- Database: Turso (libSQL) ---
# Cloud database: `turso db show <name> --url` and `turso db tokens create <name>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Used when TURSO_DATABASE_URL is empty: a local libSQL file (same engine, including vector search).
DATABASE_URL=sqlite+libsql:///./formpilot.db

# Where encrypted uploads are stored.
STORAGE_DIR=./storage

# --- LLM: Groq (https://console.groq.com/keys) ---
# Empty = rule-based extraction and embedding matching only.
GROQ_API_KEY=
# Must support strict JSON-schema output on Groq.
LLM_MODEL=openai/gpt-oss-120b

# --- Embeddings for semantic search and RAG ---
# "fastembed" runs a local model (downloaded once, ~70 MB). "hash" needs no download but only matches spelling.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=4

# --- Sign in with Google (optional) ---
# Authorized redirect URI: <API_PUBLIC_URL or APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the web app (OAuth returns the browser here).
APP_URL=http://localhost:5173
# Public URL of this API, if it isn't served under APP_URL/api.
# API_PUBLIC_URL=

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Redirect HTTP to HTTPS and send HSTS. Defaults to true when ENVIRONMENT=production.
# ENFORCE_HTTPS=true

# Behind a reverse proxy (Nginx, Render, Railway...), trust its X-Forwarded-* headers
# so HTTPS detection and per-IP rate limits see the real client.
TRUST_PROXY_HEADERS=false

# Per-IP limits on sign-up, sign-in, contact and uploads.
RATE_LIMIT_ENABLED=true
SESSION_HOURS=12

# --- Sessions and passwords ---
# "Remember me" keeps people signed in for this many days.
REMEMBER_DAYS=30
# Password reset links expire after this many minutes.
RESET_TOKEN_MINUTES=30

# --- Email for password reset links (optional) ---
# Without SMTP_HOST, links are logged and, outside production, shown on the Forgot Password page.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FormPilot <no-reply@formpilot.app>
