# Base URL of the FormPilot API. Leave empty to use the Vite dev proxy (/api -> localhost:8000).
# Only VITE_-prefixed variables are exposed to the browser. Never put secrets here.
VITE_API_BASE_URL=

# Optional privacy-friendly analytics (Plausible). Leave empty to disable analytics entirely.
# Scripts only load after the visitor accepts analytics in the cookie banner.
VITE_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible? Point this at your script.manual.js.
VITE_PLAUSIBLE_SRC=

# Where the dev server (npm run dev) forwards /api. Empty: the deployed Render API.
# Use a local backend instead: API_PROXY_TARGET=http://127.0.0.1:8000
API_PROXY_TARGET=
