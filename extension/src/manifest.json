{
  "manifest_version": 3,
  "name": "FormPilot",
  "short_name": "FormPilot",
  "version": "1.0.0",
  "description": "Your reusable application profile for the web. Build your profile once, fill forms anywhere. You review everything and submit yourself.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FormPilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://formpilot-six.vercel.app/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
